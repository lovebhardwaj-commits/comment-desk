# Your Meta app (App Dashboard > App settings > Basic)
META_APP_ID=
META_APP_SECRET=
# Optional: Facebook Login for Business configuration ID. If empty, the app asks for the permissions in lib/graph.ts directly.
META_LOGIN_CONFIG_ID=
# Graph API version
GRAPH_VERSION=v25.0

# Public URL of the deployed app, no trailing slash, e.g. https://comment-moderator.vercel.app
APP_URL=

# Random string of at least 32 characters, used to encrypt the login cookie
SESSION_SECRET=

# Recommended: keeps the team's past category corrections permanently (the built-in model trains on them).
# Create a free Upstash Redis database (Vercel Marketplace > Upstash) and paste its REST URL and token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI analysis ("Why are people saying this?"), through OpenRouter. Both are needed to switch it on.
# Key: openrouter.ai/keys (set a spending limit on it). Model: pick one from openrouter.ai/models, e.g. a Grok model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional: only change this to test against another OpenRouter-compatible server.
OPENROUTER_BASE_URL=
