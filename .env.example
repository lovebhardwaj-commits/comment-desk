# Your Meta app (App Dashboard > App settings > Basic)
META_APP_ID=
META_APP_SECRET=
# Optional: Facebook Login for Business configuration ID. If empty, the app asks for the permissions in lib/graph.ts directly.
META_LOGIN_CONFIG_ID=
# Graph API version
GRAPH_VERSION=v25.0

# Public URL of the deployed app, no trailing slash, e.g. https://comment-moderator.vercel.app
APP_URL=

# Random string of at least 32 characters, used to encrypt the login cookie
SESSION_SECRET=

# Categorisation engine. Leave empty to use the free built-in model.
# Set to "claude" (and add an Anthropic API key) to use Claude instead: more accurate, but paid per comment.
CLASSIFIER=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Optional, only used with CLASSIFIER=claude: cache so comments are not re-categorised (and re-paid for) on every open.
# Create a free Upstash Redis database (Vercel Marketplace > Upstash) and paste its REST URL and token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
